#!/usr/bin/env bash
#
# fetch-chand — Chand rate fetcher for the Omarchy Chand bar plugin.
#
# HYBRID SOURCES (mirrors the Chand iOS app):
#   * Wallex (api.wallex.ir) — REAL-TIME, TMN-quoted markets (USDTTMN, BTCTMN,
#     ETHTMN, XRPTMN, LTCTMN, BNBTMN, XAUTTMN) for live prices AND full chart
#     history via its UDF klines endpoint (hourly for 1d/1w, daily beyond).
#   * TGJU (call5.tgju.org/ajax.json) — live fiat + physical-coin prices.
#     TGJU quotes RIAL (toman = rial / 10); crypto rows are USD.
#   * api.tgju.org (TGJU first-party) — daily OHLC history back to 2012 for
#     every TGJU asset, used for fiat/coin chart ranges.
#
# All chart ranges are cached in ~/.cache/omarchy-chand/charts and rebuilt in
# the background by `warm` (the panel runs it every 5 minutes). `history`
# serves the cached chart instantly when present and only hits the network on
# a cold miss, so opening a detail chart never blocks on fetching.
#
#   fetch-chand current [key...]          -> { ok, items:[ ... ] }
#   fetch-chand history [key] [range]     -> { ok, key, range, series, summary }
#   fetch-chand warm [key...]             -> rebuild current + every range
#
# Dependencies: curl, jq. No pip / npm / sudo / hooks.

set -o pipefail

UA="Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15"
WALLEX_URL="https://api.wallex.ir/v1/markets"
WALLEX_KLINE_URL="https://api.wallex.ir/v1/udf/history"
TGJU_URL="https://call5.tgju.org/ajax.json"
TGJU_HIST_URL="https://api.tgju.org/v1/market/indicator/summary-table-data"
CACHE_DIR="${CHAND_CACHE_DIR:-$HOME/.cache/omarchy-chand}"
HISTORY_DIR="$CACHE_DIR/history"
CHARTS_DIR="$CACHE_DIR/charts"
MAX_POINTS=8000
RANGES=(1d 1w 1y 5y all)
EPOCH_FLOOR=946684800   # 2000-01-01: bounds "all" and avoids negative epochs

mkdir -p "$HISTORY_DIR" "$CHARTS_DIR" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Asset table: key -> source + remote symbol/key.
#   src "wallex" : wallex symbol, TMN-quoted (BTCTMN, XAUTTMN, ...)
#   src "tgju"   : tgju current key (price_eur, sekee, ...)
# ---------------------------------------------------------------------------
wallex_sym() { # key -> wallex symbol (empty if not wallex)
  case "$1" in
    price_dollar_rl) echo "USDTTMN" ;;       # live USD in Toman
    crypto-tether)   echo "USDTTMN" ;;       # Tether ~ USD in Toman
    crypto-bitcoin)  echo "BTCTMN" ;;
    crypto-ethereum) echo "ETHTMN" ;;
    crypto-ripple)   echo "XRPTMN" ;;
    crypto-litecoin) echo "LTCTMN" ;;
    crypto-binance-coin) echo "BNBTMN" ;;
    gerami)          echo "XAUTTMN" ;;       # gold token ~ 1g gold
    *) echo "" ;;
  esac
}
tgju_key() { # key -> tgju key (empty if not tgju)
  local w; w="$(wallex_sym "$1")"
  [ -n "$w" ] && { echo ""; return; }
  case "$1" in
    price_dollar_rl|price_eur|price_gbp|price_aed|price_try|price_chf|price_sek|price_nok|price_dkk|price_sgd|price_cad|price_aud|price_cny|price_jpy|price_hkd|price_inr|price_myr|price_thb|price_rub|price_qar|price_omr|price_kwd|price_sar|price_iqd|price_bhd|price_azn|price_amd|price_afn|geram18|geram24|mesghal|sekee|sekeb|nim|rob) echo "$1" ;;
    crypto-eos) echo "crypto-eos" ;;
    *) echo "" ;;
  esac
}
src_of() {
  local w; w="$(wallex_sym "$1")"
  [ -n "$w" ] && { echo "wallex"; return; }
  local t; t="$(tgju_key "$1")"
  [ -n "$t" ] && { echo "tgju"; return; }
  echo "unknown"
}

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() {
  printf '{"ok":false,"error":%s}\n' "$(jq -nc --arg m "$1" '$m')" >&2
  printf '{"ok":false,"error":%s}\n' "$(jq -nc --arg m "$1" '$m')"
  exit 0
}

num() { printf '%s' "${1//,/}"; }

tehran_epoch() { TZ=Asia/Tehran date +%s; }
tehran_date()  { TZ=Asia/Tehran date +%Y-%m-%d; }

cache_file() { printf '%s/%s.jsonl' "$HISTORY_DIR" "$1"; }
chart_file() { printf '%s/%s_%s.json' "$CHARTS_DIR" "$1" "$2"; }

# Normalize all numbers in a JSON payload: drop float noise
# (204999.0000000000000000 -> 204999), cap precision at 2 decimals.
# Note: the match arm MUST return (.|floor); returning "." preserves the
# long float representation.
normalize_numbers() {
  jq -c '(.. | numbers) |= (if . == floor then (.|floor) else ((. * 100 | round) / 100) end)'
}

# ---------------------------------------------------------------------------
# raw fetches (memoized within one invocation)
# ---------------------------------------------------------------------------

WALLEX_RAW=""
fetch_wallex() {
  [ -n "$WALLEX_RAW" ] && return 0
  # Wallex sometimes prepends a stray NUL byte; command substitution strips
  # NULs, which corrupts the JSON and breaks every path that funnels the
  # payload through the shell. Strip it up front.
  WALLEX_RAW="$(curl -fsS --max-time 12 -A "$UA" "$WALLEX_URL" 2>/dev/null | tr -d '\000')" || return 1
  printf '%s' "$WALLEX_RAW" | jq -e '.result.symbols' >/dev/null 2>&1 || return 1
  return 0
}

TGJU_RAW=""
fetch_tgju() {
  [ -n "$TGJU_RAW" ] && return 0
  TGJU_RAW="$(curl -fsS --max-time 12 -A "$UA" "$TGJU_URL" 2>/dev/null)" || return 1
  printf '%s' "$TGJU_RAW" | jq -e '.current' >/dev/null 2>&1 || return 1
  return 0
}

# ---------------------------------------------------------------------------
# history cache (append-only, capped)
# ---------------------------------------------------------------------------

# Reject an obviously-wrong point (e.g. a stale raw-rial value 10x off the
# prior point) so a transient bad fetch can't poison the intraday cache and make
# 1d/1w charts spike. Tolerance: >3x the last point, and last point exists.
last_toman() {
  local f; f="$(cache_file "$1")"
  [ -f "$f" ] || { printf ''; return; }
  tail -n 1 "$f" 2>/dev/null | awk 'match($0,/"toman":([0-9.]+)/,m){print m[1]}'
}

append_history() {
  local key="$1" toman="$2" ts="$3"
  [ -z "$toman" ] && return
  local prev; prev="$(last_toman "$key")"
  if [ -n "$prev" ] && awk -v p="$prev" -v c="$toman" 'BEGIN{exit !((c>p*3)||(c<p/3))}'; then
    return   # improbable jump -> skip to protect the series
  fi
  local f; f="$(cache_file "$key")"
  printf '{"ts":%s,"toman":%s}\n' "$ts" "$toman" >>"$f" 2>/dev/null || return
  local lines; lines="$(wc -l <"$f" 2>/dev/null || echo 0)"
  if [ "$lines" -gt "$MAX_POINTS" ]; then
    tail -n "$MAX_POINTS" "$f" >"$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  fi
}

# 5-minute-tick reference: the latest cached price from ~5 minutes
# before *this* poll. append_history() just appended the current point, so we
# skip the last line and take the most recent point older than 5 min.
prev_tick_toman() {
  local key="$1" f; f="$(cache_file "$key")"
  [ -f "$f" ] || { printf ''; return; }
  awk -v now="$(date +%s)" -v win=300 '
    match($0,/"ts":([0-9]+)/,m) && match($0,/"toman":([0-9.]+)/,n) {
      t=(m[1]+0); v=(n[1]+0)
      if ((now - t) > win && (now - t) < (win*20)) cand=v
    }
    END { if (cand != "") printf "%s", cand }
  ' "$f"
}


# ---------------------------------------------------------------------------
# resolvers -> prints: toman rial change_pct change_toman high_toman low_toman buy sell src
# ---------------------------------------------------------------------------

resolve_wallex() {
  local sym="$1"
  local s; s="$(printf '%s' "$WALLEX_RAW" | jq -c --arg s "$sym" '.result.symbols[$s] // empty')"
  [ -z "$s" ] && { printf 'ERR:missing:%s' "$sym"; return 1; }
  local last high low ch
  last="$(printf '%s' "$s" | jq -r '.stats.lastPrice // "0"')"
  high="$(printf '%s' "$s" | jq -r '.stats["24h_highPrice"] // "0"')"
  low="$(printf '%s' "$s" | jq -r '.stats["24h_lowPrice"] // "0"')"
  ch="$(printf '%s' "$s" | jq -r '.stats["24h_ch"] // "0"')"
  last="$(num "$last")"; high="$(num "$high")"; low="$(num "$low")"; ch="$(num "$ch")"
  [ "$last" = "0" ] && { printf 'ERR:zero:%s' "$sym"; return 1; }
  local toman change_t
  toman="$last"
  change_t="$(awk -v t="$toman" -v p="$ch" 'BEGIN{printf "%.2f", t*p/100}')"
  printf '%s %s %s %s %s %s %s %s %s' \
    "$toman" "$toman" "$ch" "$change_t" "$high" "$low" "$toman" "$toman" "wallex"
  return 0
}

resolve_tgju() {
  local key="$1"
  local entry
  entry="$(printf '%s' "$TGJU_RAW" | jq -c --arg k "$key" '.current[$k] // empty')"
  [ -z "$entry" ] && { printf 'ERR:missing:%s' "$key"; return 1; }
  local p d dp h l
  p="$(printf '%s' "$entry" | jq -r '.p // "0"')"; p="$(num "$p")"
  d="$(printf '%s' "$entry" | jq -r '.d // "0"')"; d="$(num "$d")"
  dp="$(printf '%s' "$entry" | jq -r '.dp // 0')"
  h="$(printf '%s' "$entry" | jq -r '.h // "0"')"; h="$(num "$h")"
  l="$(printf '%s' "$entry" | jq -r '.l // "0"')"; l="$(num "$l")"
  # TGJU quotes RIAL for fiat/coins (toman = rial/10); crypto rows are USD
  # -> convert via the live USDTTMN rate.
  case "$key" in crypto-*)
    fetch_wallex || { printf 'ERR:nowallex'; return 1; }
    local rate toman2
    rate="$(printf '%s' "$WALLEX_RAW" | jq -r '.result.symbols.USDTTMN.stats.lastPrice // "0"')"
    rate="$(num "$rate")"
    toman2="$(awk -v u="$p" -v r="$rate" 'BEGIN{printf "%.2f", u*r}')"
    p="$toman2"
    d="$(awk -v u="$d" -v r="$rate" 'BEGIN{printf "%.2f", u*r}')"
    h="$(awk -v u="$h" -v r="$rate" 'BEGIN{printf "%.2f", u*r}')"
    l="$(awk -v u="$l" -v r="$rate" 'BEGIN{printf "%.2f", u*r}')"
    ;;
  *)
    # rial -> toman (fiat + coins). Crypto already handled above.
    p="$(awk -v r="$p" 'BEGIN{printf "%.2f", r/10}')"
    d="$(awk -v r="$d" 'BEGIN{printf "%.2f", r/10}')"
    h="$(awk -v r="$h" 'BEGIN{printf "%.2f", r/10}')"
    l="$(awk -v r="$l" 'BEGIN{printf "%.2f", r/10}')"
    ;;
  esac
  local toman rial high_toman low_toman change_toman
  toman="$p"; rial="$(awk -v r="$toman" 'BEGIN{printf "%.0f", r*10}')"
  high_toman="$h"; low_toman="$l"
  change_toman="$d"
  printf '%s %s %s %s %s %s %s %s %s' \
    "$toman" "$rial" "$dp" "$change_toman" "$high_toman" "$low_toman" "null" "null" "tgju"
  return 0
}

# resolve_to_file: same as resolve() but writes the space-separated result
# line (or an ERR: line) into $2. Every fetch path must go through command
# substitution only where unavoidable — resolve itself must NOT run in a
# subshell or the memoized WALLEX_RAW/TGJU_RAW die with each call.
resolve_to_file() {
  local key="$1" out="$2" src
  src="$(src_of "$key")"
  case "$src" in
    wallex) fetch_wallex  && resolve_wallex "$(wallex_sym "$key")" >"$out" || printf 'ERR:%s' "$src" >"$out" ;;
    tgju)   fetch_tgju    && resolve_tgju   "$(tgju_key "$key")"   >"$out" || printf 'ERR:%s' "$src" >"$out" ;;
    *) printf 'ERR:unknown' >"$out" ;;
  esac
  # resolve_* return 1 with ERR: printed on failure; the file starts with
  # ERR: in that case.
}

emit_item() {
  local key="$1"
  local resf; resf="$(mktemp)"
  resolve_to_file "$key" "$resf"
  local res; res="$(cat "$resf")"
  rm -f "$resf"
  case "$res" in
    ERR:*|"")
      jq -nc --arg key "$key" '{ok:false, key:$key, error:"unresolved"}'
      return
      ;;
  esac
  local toman rial dp change_toman high low buy sell src
  read -r toman rial dp change_toman high low buy sell src <<<"$res"

  local ts; ts="$(tehran_epoch)"
  # 5-minute tick: price vs the cached point ~5 min ago (before this poll's
  # own append). Drives the live pill color (up=green/down=red vs 5 min ago),
  # which is independent of any chart range's delta.
  local prev; prev="$(prev_tick_toman "$key")"
  local tick_dir="flat" tick_delta="0"
  if [ -n "$prev" ] && [ "$prev" != "0" ]; then
    tick_delta="$(awk -v a="$prev" -v b="$toman" 'BEGIN{printf "%.2f", b-a}')"
    if awk -v d="$tick_delta" 'BEGIN{exit !(d>0)}'; then tick_dir="up"
    elif awk -v d="$tick_delta" 'BEGIN{exit !(d<0)}'; then tick_dir="down"; fi
  fi
  append_history "$key" "$toman" "$ts"

  jq -nc \
    --arg key "$key" --arg src "$src" \
    --argjson toman "$toman" --argjson rial "$rial" \
    --argjson change_pct "$dp" --argjson change_toman "$change_toman" \
    --argjson high_toman "$high" --argjson low_toman "$low" \
    --argjson tick_delta "$tick_delta" --arg tick_dir "$tick_dir" \
    --arg buy "$buy" --arg sell "$sell" \
    --arg fa "$(tehran_date)" \
    '{
      ok:true, key:$key, source:$src,
      toman:$toman, rial:$rial,
      change_pct:$change_pct, change_toman:$change_toman,
      tick_delta:$tick_delta, tick_dir:$tick_dir,
      high_toman:$high_toman, low_toman:$low_toman,
      buy_toman:(if $buy=="null" then null else ($buy|tonumber) end),
      sell_toman:(if $sell=="null" then null else ($sell|tonumber) end),
      tehran_date:$fa, fetched_at:(now|todate)
    }' \
    | normalize_numbers
}

cmd_current() {
  local keys=("$@")
  [ "${#keys[@]}" -eq 0 ] && die "current requires at least one key"
  # Emit into a temp file rather than via $(emit_item): command substitution
  # runs each call in a subshell, which defeats the memoized TGJU/Wallex
  # fetches (one network hit per key instead of one total).
  local tmp; tmp="$(mktemp)"
  local k
  for k in "${keys[@]}"; do
    emit_item "$k" >>"$tmp"
  done
  printf '{"ok":true,"items":[%s]}\n' "$(paste -sd, "$tmp")"
  rm -f "$tmp"
}

# ---------------------------------------------------------------------------
# history
# ---------------------------------------------------------------------------

range_days() {
  case "$1" in
    1d) echo 1;; 1w) echo 7;; 1y) echo 365;; 5y) echo 1825;; all) echo 36500;;
    *) echo 30;;
  esac
}

# Wallex kline resolution per range: hourly for short ranges (real intraday
# movement), daily beyond.
range_res() {
  case "$1" in
    1d) echo 60;;   # hourly -> ~24 pts/day
    1w) echo 60;;   # hourly -> ~168 pts/week
    1y) echo D;;    # daily  -> ~365 pts/year
    5y) echo D;;    # daily  -> ~1812 pts/5y
    all) echo D;;   # daily  -> ~2754 pts/all
    *) echo D;;
  esac
}

fetch_wallex_klines() {
  local sym="$1" from="$2" to="$3" res="${4:-D}"
  curl -fsS --max-time 20 -A "$UA" \
    "$WALLEX_KLINE_URL?symbol=$sym&resolution=$res&from=$from&to=$to" 2>/dev/null
}

# TGJU daily OHLC raw payload, memoized per key within one invocation: warm
# builds 5 ranges per key and the full-history payload is ~600KB per asset.
declare -A TGHIST_MEMO
tgju_hist_raw() {
  local k="$1"
  if [[ -v TGHIST_MEMO[$k] ]]; then
    printf '%s' "${TGHIST_MEMO[$k]}"
    return 0
  fi
  local v
  v="$(curl -fsS --max-time 30 -A "$UA" \
    "$TGJU_HIST_URL/$k?lang=en&order_dir=desc&draw=1&start=0&length=10000" 2>/dev/null)" || { echo ""; return 1; }
  TGHIST_MEMO[$k]="$v"
  printf '%s' "$v"
}

# TGJU daily OHLC: rows are [open,low,high,close,change,change%,gregorian,jalali]
# in RIAL (crypto rows in USD). order_dir=desc -> newest first. Prices are
# comma-formatted strings. Returns JSON array of {ts,toman}, ascending.
# unit: "rial" (divide by 10) or "usd" (multiply by live USDTTMN rate).
fetch_tgju_daily() {
  local tgjukey="$1" cutoff="$2" unit="$3"
  local raw; raw="$(tgju_hist_raw "$tgjukey")" || { echo "[]"; return; }
  [ -z "$raw" ] && { echo "[]"; return; }
  local conv
  if [ "$unit" = "usd" ]; then
    fetch_wallex || { echo "[]"; return; }
    conv="$(num "$(printf '%s' "$WALLEX_RAW" | jq -r '.result.symbols.USDTTMN.stats.lastPrice // "0"')")"
    [ "$conv" = "0" ] || [ -z "$conv" ] && { echo "[]"; return; }
    printf '%s' "$raw" | jq -c --argjson cutoff "$cutoff" --argjson rate "$conv" '
      [ .data[]
        | (.[6] as $ds | .[3] as $c
          | ($ds | strptime("%Y/%m/%d") | mktime) as $ts
          | select($ts >= $cutoff)
          | {ts:$ts, toman:($c | gsub(","; "") | tonumber * $rate)})
      ] | sort_by(.ts)'
  else
    printf '%s' "$raw" | jq -c --argjson cutoff "$cutoff" '
      [ .data[]
        | (.[6] as $ds | .[3] as $c
          | ($ds | strptime("%Y/%m/%d") | mktime) as $ts
          | select($ts >= $cutoff)
          | {ts:$ts, toman:($c | gsub(","; "") | tonumber / 10)})
      ] | sort_by(.ts)'
  fi
}

# Build a full chart for key+range (network) -> prints compact {ts,toman} JSON
# array. Tries Wallex klines first; TGJU daily rows otherwise; the local
# 5-minute append cache last (gives TGJU assets intraday points for 1d/1w).
build_series() {
  local key="$1" range="$2" cutoff="$3" now="$4"
  local src; src="$(src_of "$key")"
  local series="[]"

  if [ "$src" = "wallex" ]; then
    local sym; sym="$(wallex_sym "$key")"
    local kl; kl="$(fetch_wallex_klines "$sym" "$cutoff" "$now" "$(range_res "$range")")"
    if [ -n "$kl" ]; then
      series="$(printf '%s' "$kl" | jq -c '
        if (.s // "") == "ok" and (.t | type) == "array" then
          [ range(0; .t | length) as $i | {ts:(.t[$i] | floor), toman:(.c[$i] | tonumber)} ]
        else [] end')"
    fi
  elif [ "$src" = "tgju" ]; then
    local tkey; tkey="$(tgju_key "$key")"
    local unit="rial"
    case "$tkey" in crypto-*) unit="usd" ;; esac
    series="$(fetch_tgju_daily "$tkey" "$cutoff" "$unit")"
  fi

  # Intraday supplement for TGJU assets on short ranges: daily rows only give
  # one point per day, so splice in the 5-minute local cache points.
  if [ "$src" = "tgju" ] && { [ "$range" = "1d" ] || [ "$range" = "1w" ]; }; then
    local f; f="$(cache_file "$key")"
    if [ -f "$f" ]; then
      local localpts
      localpts="$(awk -v c="$cutoff" '
        match($0,/"ts":([0-9]+)/,m) && match($0,/"toman":([0-9.]+)/,n) && (m[1]+0) >= c {
          printf "{\"ts\":%s,\"toman\":%s}\n", m[1], n[1]
        }' "$f" | jq -s 'sort_by(.ts)')"
      series="$(printf '%s' "$series" | jq -c --argjson lp "$localpts" '$lp + . | unique_by(.ts) | sort_by(.ts)')"
    fi
  fi

  printf '%s' "$series"
}

# Summary meta from a series: points, high/low, first/last, range delta,
# first->last prices (the "was this, now that" pair shown in the header).
series_meta() {
  printf '%s' "$1" | jq -c '
    if length == 0 then
      {points:0, high:null, low:null, from:null, to:null,
       first_price:null, last_price:null, range_delta:null,
       jalali_from:"", jalali_to:""}
    else
      (map(.toman) | {high:max, low:min}) as $hl
      | (.[0].ts) as $from | (.[-1].ts) as $to
      | (.[0].toman) as $fp | (.[-1].toman) as $lp
      | {points:length, high:$hl.high, low:$hl.low, from:$from, to:$to,
         first_price:$fp, last_price:$lp, range_delta:($lp - $fp),
         jalali_from:($from|strftime("%Y-%m-%d")),
         jalali_to:($to|strftime("%Y-%m-%d"))}
    end'
}

cmd_history() {
  local key="$1" range="${2:-1y}"
  [ -z "$key" ] && die "history requires a key"
  local cf; cf="$(chart_file "$key" "$range")"

  # Serve the cached chart instantly when it exists. The background `warm`
  # (run by the panel every 5 min) keeps these fresh; opening a chart must
  # never block on the network when a cached copy is available.
  if [ -s "$cf" ]; then
    cat "$cf"
    return
  fi

  # Cold miss: build synchronously and cache.
  build_and_cache "$key" "$range"
}

build_and_cache() {
  local key="$1" range="${2:-1y}"
  local now; now="$(date +%s)"
  local days; days="$(range_days "$range")"
  local cutoff=$(( now - days * 86400 ))
  [ "$cutoff" -lt "$EPOCH_FLOOR" ] && cutoff="$EPOCH_FLOOR"

  local series; series="$(build_series "$key" "$range" "$cutoff" "$now")"

  # Never return an empty chart if the local cache has anything.
  local npts=0
  if [ -n "$series" ]; then
    npts="$(printf '%s' "$series" | jq -r 'if type=="array" then length else 0 end' 2>/dev/null || echo 0)"
  fi
  if [ "$npts" = "0" ]; then
    local f; f="$(cache_file "$key")"
    [ -f "$f" ] && series="$(awk -v c="$cutoff" '
      match($0,/"ts":([0-9]+)/,m) && match($0,/"toman":([0-9.]+)/,n) && (m[1]+0) >= c {
        printf "{\"ts\":%s,\"toman\":%s}\n", m[1], n[1]
      }' "$f" | jq -s 'sort_by(.ts)')"
  fi

  local meta; meta="$(series_meta "$series")"

  local eff_range="$range"
  if [ "$range" = "all" ]; then
    local span; span="$(printf '%s' "$meta" | jq -r 'if .points>0 then ((.to-.from)/86400|floor|tostring) else "0" end')"
    eff_range="all(${span}d)"
  fi

  # Write the (potentially large) series to a temp file and read it back via
  # --slurpfile instead of --argjson, which fails with "Argument list too long"
  # for multi-year ranges (~150KB of kline points).
  local serfile outfile
  serfile="$(mktemp)"
  outfile="$(mktemp)"
  printf '%s' "$series" >"$serfile"

  jq -nc --arg key "$key" --arg range "$eff_range" \
    --slurpfile series "$serfile" --argjson meta "$meta" \
    '{ok:true, key:$key, range:$range, series:$series[0], summary:$meta}' \
    | normalize_numbers >"$outfile"

  cp "$outfile" "$(chart_file "$key" "$range")" 2>/dev/null || true
  cat "$outfile"
  rm -f "$serfile" "$outfile"
}

# ---------------------------------------------------------------------------
# warm: rebuild current + every cached chart range in the background.
# The panel runs this on a 5-minute timer so `history` always serves a fresh
# cached chart instantly and opening a chart never waits on the network.
# ---------------------------------------------------------------------------

chart_age_min() { # file -> age in minutes, -1 if missing
  local f="$1"
  [ -f "$f" ] || { echo -1; return; }
  echo $(( ( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ) / 60 ))
}

cmd_warm() {
  local keys=("$@")
  [ "${#keys[@]}" -eq 0 ] && die "warm requires at least one key"

  # Every chart range for every key. Current prices are the panel poller's job
  # (it appends the intraday points these charts splice in); warm is charts.
  # TGJU long ranges are daily rows -> skip a rebuild while the cached chart
  # is under 12h old (their 1d/1w still splice fresh intraday cache points).
  local k r age
  for k in "${keys[@]}"; do
    for r in "${RANGES[@]}"; do
      case "$r" in 1y|5y|all)
        if [ "$(src_of "$k")" = "tgju" ]; then
          age="$(chart_age_min "$(chart_file "$k" "$r")")"
          [ "$age" -ge 0 ] && [ "$age" -lt 720 ] && continue
        fi
        ;;
      esac
      build_and_cache "$k" "$r" >/dev/null 2>&1 || true
    done
  done
  printf '{"ok":true,"warmed":%s}\n' "${#keys[@]}"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
  current) shift; cmd_current "$@";;
  history) cmd_history "${2:-}" "${3:-1y}";;
  warm)    shift; cmd_warm "$@";;
  *) die "usage: fetch-chand current <key>... | history <key> [1d|1w|1y|5y|all] | warm <key>...";;
esac
